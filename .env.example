# Safe public frontend values for EmailJS (these are intentionally exposed to the browser)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# Server-side secrets. Do NOT prefix these with VITE_ and do NOT expose them in frontend code.
PORT=4000
NAS_BASE_URL=https://nas.example.local/files
NAS_USER=your-nas-username
NAS_PASS=your-nas-password
IMAGE_LIST_URL=https://nas.example.local/image-index.json
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GOOGLE_ALLOWED_EMAILS=your-email@gmail.com
SESSION_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5173

# Netlify note:
# Use the same variables in Netlify Site settings, not in source-controlled files.
# For false-positive secret scans on EmailJS values, set:
# SECRETS_SCAN_OMIT_KEYS=VITE_EMAILJS_PUBLIC_KEY,VITE_EMAILJS_SERVICE_ID,VITE_EMAILJS_TEMPLATE_ID
