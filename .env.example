# Safe public frontend values for EmailJS (these are intentionally exposed to the browser)
VITE_EMAILJS_PUBLIC_KEY=replace-with-public-key
VITE_EMAILJS_SERVICE_ID=replace-with-service-id
VITE_EMAILJS_TEMPLATE_ID=replace-with-template-id
VITE_BACKEND_URL=http://localhost:4000
# On Netlify, set VITE_BACKEND_URL=https://backend-we97.onrender.com instead.

# Render backend environment (Netlify variables are NOT shared with Render).
# Do NOT prefix private values with VITE_. Set NODE_ENV=production on Render.
NODE_ENV=development
PORT=4000
NAS_BASE_URL=https://nas.example.local/files
NAS_USER=replace-with-nas-user
NAS_PASS=replace-with-nas-password
IMAGE_LIST_URL=https://nas.example.local/image-index.json
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GOOGLE_ALLOWED_EMAILS=your-email@example.com
SESSION_SECRET=replace-with-long-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
# Optional persistent disk paths on Render; see SECURITY_SETUP.md.
# DATA_DIR=/var/data/photography/data
# UPLOADS_DIR=/var/data/photography/uploads

# Netlify note:
# Only VITE_* public frontend values belong in Netlify Site settings.
# For false-positive secret scans on env names and local placeholder files, set:
# SECRETS_SCAN_OMIT_KEYS=VITE_EMAILJS_PUBLIC_KEY,VITE_EMAILJS_SERVICE_ID,VITE_EMAILJS_TEMPLATE_ID,VITE_BACKEND_URL
