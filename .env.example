# Safe public frontend values for EmailJS (these are intentionally exposed to the browser)
VITE_EMAILJS_PUBLIC_KEY=replace-with-public-key
VITE_EMAILJS_SERVICE_ID=replace-with-service-id
VITE_EMAILJS_TEMPLATE_ID=replace-with-template-id

# Server-side secrets. Do NOT prefix these with VITE_ and do NOT expose them in frontend code.
PORT=4000
NAS_BASE_URL=https://nas.example.local/files
NAS_USER=replace-with-nas-user
NAS_PASS=replace-with-nas-password
IMAGE_LIST_URL=https://nas.example.local/image-index.json
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
GOOGLE_ALLOWED_EMAILS=your-email@example.com
SESSION_SECRET=replace-with-long-random-secret
FRONTEND_URL=http://localhost:5173

# Netlify note:
# Use the same variables in Netlify Site settings, not in source-controlled files.
# For false-positive secret scans on env names and local placeholder files, set:
# SECRETS_SCAN_OMIT_KEYS=VITE_EMAILJS_PUBLIC_KEY,VITE_EMAILJS_SERVICE_ID,VITE_EMAILJS_TEMPLATE_ID,GOOGLE_CLIENT_ID,GOOGLE_CLIENT_SECRET,GOOGLE_ALLOWED_EMAILS,SESSION_SECRET,NAS_BASE_URL,NAS_USER,NAS_PASS,IMAGE_LIST_URL,PORT
