# Copy to .env and fill the values. Do NOT commit secrets to git.
# NAS settings: provide a base URL where images are reachable (http(s) or WebDAV/S3 gateway)
NAS_BASE_URL=https://nas.example.local/files
# If your NAS requires HTTP basic auth provide these (or configure the proxy to use mTLS or other auth)
NAS_USER=your-nas-username
NAS_PASS=your-nas-password
# Optional: a public JSON index of your images (a simple list of relative paths). If provided, the web app will use it.
IMAGE_LIST_URL=https://nas.example.local/image-index.json
# Server port for the image-proxy
PORT=4000
